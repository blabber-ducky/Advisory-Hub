# TLS-terminating reverse proxy for Advisory Hub.
#
# Baked into the advisory-hub-proxy image (docker/nginx/Dockerfile) and
# rendered at container start by the nginx image's envsubst step
# (/etc/nginx/templates/*.template → /etc/nginx/conf.d/*.conf). Only the
# ${SERVER_NAME} and ${HSTS_MAX_AGE} variables below are substituted —
# NGINX_ENVSUBST_FILTER in the Dockerfile restricts it, so nginx's own
# $host/$remote_addr/etc. are left alone. Editing this file means
# rebuilding the proxy image.
#
# Certificates are NOT generated or stored in the repo. They are installed
# into TLS_CERT_DIR on the host by scripts/https-setup.sh and mounted
# read-only at /etc/nginx/certs. See docs/operations.md §7.

# Plain HTTP only ever redirects. Nothing is served over it.
server {
    listen 80;
    listen [::]:80;
    server_name _;

    location = /health/live {
        # Lets a load balancer probe liveness without following a redirect.
        access_log off;
        proxy_pass http://app:8000;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/server.crt;   # leaf + intermediates
    ssl_certificate_key /etc/nginx/certs/server.key;

    # Mozilla "intermediate" profile: TLS 1.2 + 1.3 only.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    server_tokens off;

    # HSTS_MAX_AGE=0 disables it (useful while trialling a self-signed cert).
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # Above CSV_MAX_BYTES (20 MB) so the app, not nginx, rejects oversize
    # inventory uploads with a readable error.
    client_max_body_size 25m;

    location / {
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # "Scan inbox now", "Sync now" and scans run synchronously.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
