# Advisory Hub — production configuration for docker-compose.prod.yml.
# TLS is terminated upstream by your enterprise WAF / reverse proxy.
#
#   cp .env.production.example .env && chmod 600 .env
#
# Replace every CHANGE_ME. The stack refuses to start while a required value
# is missing. Walkthrough: docs/deployment.md. Every other setting in
# .env.example (VT_API_KEY, PDF_*, CSV_*, …) may also be added here — the
# whole file is passed to the app and worker.

# ─── Compose ─────────────────────────────────────────────────────────────────
# Makes plain `docker compose …` use the production file. Don't change.
COMPOSE_FILE=docker-compose.prod.yml

# ─── Images (published by CI — docs/operations.md §8) ────────────────────────
# Docker Hub user/org. Pulls <namespace>/advisory-hub.
IMAGE_NAMESPACE=CHANGE_ME
# Pin a release (1.4.0) or commit (sha-1a2b3c4). There is no "latest" default.
IMAGE_TAG=CHANGE_ME

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Generate each one; never reuse the development values.
#   SECRET_KEY:        openssl rand -base64 48 | tr -d '\n'
#   POSTGRES_PASSWORD: openssl rand -hex 32        (hex: it goes inside a URL)
#   FERNET_KEY:        openssl rand -base64 32 | tr '+/' '-_'
# FERNET_KEY encrypts integration credentials. Back it up separately from
# the database — losing it means re-entering every credential.
SECRET_KEY=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
FERNET_KEY=CHANGE_ME

# ─── Front door (your WAF / reverse proxy, not this stack) ───────────────────
# The app container publishes plain HTTP directly — there is no TLS listener
# in this file at all. Your WAF/proxy must terminate TLS and forward Host,
# X-Forwarded-For and X-Forwarded-Proto unmodified. Firewall APP_PORT so only
# the WAF/proxy can reach it; never expose it to the wider network.
#
# Comma-separated list of the WAF/proxy's own address(es) — the app trusts
# X-Forwarded-For/-Proto ONLY from these peers (uvicorn --forwarded-allow-ips
# format: literal IPs, not CIDR ranges — list every address it connects
# from, e.g. each node of an HA pair).
TRUSTED_PROXY_IPS=CHANGE_ME
# Host port app listens on. Default 8000.
# APP_PORT=8000
# Restrict to one interface, e.g. the internal NIC facing the WAF.
# BIND_ADDRESS=0.0.0.0

# ─── Inbox ───────────────────────────────────────────────────────────────────
# All data lives in ./data/<volume> next to the compose file — back up that
# folder plus this .env (docs/operations.md §4).
# Unset, the watched inbox is ./data/inbox. To use a folder Power Automate /
# a mail rule writes to elsewhere, give its absolute path (writable by uid
# 10001).
# INBOX_HOST_PATH=/srv/advisory-hub/inbox

# ─── Integrations ────────────────────────────────────────────────────────────
# Hosts the SSRF guard lets inventory integrations reach. For Azure/Graph
# include login.microsoftonline.com too.
OUTBOUND_ALLOWLIST=
# Optional here — both can also be set from /admin, which takes precedence.
NVD_API_KEY=
VT_API_KEY=

# ─── Tuning ──────────────────────────────────────────────────────────────────
# uvicorn processes. 1 is plenty for an internal team; each extra process
# costs ~100 MB (one measured at 83 MB idle) and needs the app memory limit
# in docker-compose.prod.yml raised to match.
# WEB_CONCURRENCY=1
LOG_LEVEL=INFO
