# Advisory Hub — configuration reference.
# Copy to .env and fill in. Every variable the app reads is documented here.
# See docs/operations.md §3 for the authoritative table.
#
# Deploying to production? Start from .env.production.example instead — it
# holds just what docker-compose.prod.yml needs (docs/deployment.md). Any
# variable below can be added to it; the whole file reaches app and worker.

# ─── Images (Docker Compose only, not read by the app) ─────────────────────────
# Docker Hub user/org CI publishes to: pulls <namespace>/advisory-hub and
# <namespace>/advisory-hub-proxy. Unset → localhost/…, i.e. locally built
# images only (development builds its own). See docs/operations.md §8.
# IMAGE_NAMESPACE=acme
# Pin a release (1.4.0) or commit (sha-1a2b3c4) in production.
# IMAGE_TAG=latest

# ─── Core ────────────────────────────────────────────────────────────────────
# Compose-level: Postgres password. Compose builds DATABASE_URL from it for
# the containers (the DATABASE_URL below is for running outside Docker).
# Hex keeps it URL-safe: openssl rand -hex 32. Default (dev only):
# advisory_hub_dev. Required by docker-compose.prod.yml.
# POSTGRES_PASSWORD=
# Postgres DSN. In Docker Compose the host is the service name.
DATABASE_URL=postgresql+psycopg://advisory_hub:CHANGE_ME@postgres:5432/advisory_hub
REDIS_URL=redis://redis:6379/0

# Session cookie signing. Rotating this logs everyone out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_dev_only_do_not_use_in_production

# ─── Storage ─────────────────────────────────────────────────────────────────
BLOB_ROOT=/data/blobs
INBOX_PATH=/data/inbox
PROCESSING_PATH=/data/processing
ARCHIVE_PATH=/data/archive
FAILED_PATH=/data/failed

# Docker Compose only (not read by the app itself): mounts a real host
# folder at /data/inbox instead of the internal named volume, for when
# Power Automate / a mail rule drops emails into a folder on this host.
# Absolute path required. Leave unset to keep using the named volume.
# INBOX_HOST_PATH=/srv/advisory-hub/inbox

# ─── Ingestion (Phase 1) ─────────────────────────────────────────────────────
INBOX_POLL_SECONDS=30
PDF_MAX_BYTES=52428800
PDF_MAX_PAGES=500
PDF_TIMEOUT_SECONDS=120
# Corpus is 135/135 text-layer (D-015); OCR is not built. Detector only.
OCR_ENABLED=false

# ─── Enrichment (Phase 1) ────────────────────────────────────────────────────
NVD_ENABLED=true
# Raises the NVD rate limit from 5 to 50 requests / 30s. Strongly recommended.
NVD_API_KEY=

# ─── VirusTotal IOC checks ────────────────────────────────────────────────────
VT_ENABLED=true
# Analyst-triggered per-IOC checks (not an automatic sweep). Unset: the
# "Check on VirusTotal" action stays visible but returns a clear
# "not configured" error instead of being hidden.
VT_API_KEY=

# ─── Integration credentials (Phase 2) ───────────────────────────────────────
# Fernet key for encrypting inventory-source credentials at rest.
# LOSING THIS MEANS RE-ENTERING EVERY CREDENTIAL. Back it up separately
# from the database dump.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
FERNET_KEY_PREVIOUS=

# Hosts the SSRF guard permits for inventory API integrations.
OUTBOUND_ALLOWLIST=

# ─── Inventory CSV ingest (Phase 2b) ─────────────────────────────────────────
CSV_MAX_BYTES=20971520
CSV_MAX_ROWS=200000

# ─── Inventory API sync (Phase 2c) ───────────────────────────────────────────
# How often the worker sweeps active API-kind sources for a due schedule_cron.
INVENTORY_SYNC_POLL_SECONDS=300

# ─── Web ─────────────────────────────────────────────────────────────────────
# Set false ONLY for local HTTP development.
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=43200

# ─── HTTPS (docker-compose.https.yml) ────────────────────────────────────────
# Compose-level only, not read by the app. Normally written for you by
# scripts/https-setup.sh — see docs/operations.md §7. Leave commented out for
# plain-HTTP development.
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# SERVER_NAME=advisoryhub.example.invalid
# HTTP_PORT=80
# HTTPS_PORT=443
# Host directory holding server.crt (leaf + chain) and server.key.
# TLS_CERT_DIR=./certs
# Seconds; 0 disables HSTS (the script sets 0 for self-signed certificates).
# HSTS_MAX_AGE=31536000

# ─── Production tuning (docker-compose.prod.yml) ──────────────────────────────
# uvicorn processes for app; each extra ~100 MB (raise app's memory limit).
# WEB_CONCURRENCY=1
# Host interface the TLS proxy listens on.
# BIND_ADDRESS=0.0.0.0

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json for production, console for local development
LOG_FORMAT=json
ENVIRONMENT=production
